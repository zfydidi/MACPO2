\@writefile{lot}{\contentsline {table}{\numberline {XI}{\ignorespaces Paired IEEE transmission-network dispatch (\textbf  {25 runs} per case): MACPO vs.\ RL-MACPO. $f_{\mathrm  {pure}}$: mean $\pm $ sample std of per-run best-so-far pure cost; lower is better. \textbf  {Success}: RL $f_{\mathrm  {pure}} \le 2\times $ paired MACPO (catastrophe flag, not a minor-variation tolerance; see text). $\Delta =(\mathrm  {MACPO}-\mathrm  {RL})/|\mathrm  {MACPO}|\times 100\%$ (positive: RL better). \textbf  {Median paired $\Delta $} $=\mathrm  {median}_i[(\mathrm  {MACPO}_i-\mathrm  {RL}_i)/|\mathrm  {MACPO}_i|]\times 100\%$ (primary cost statistic). \textbf  {Wilcoxon}: two-sided signed-rank test on paired $(\mathrm  {MACPO}_i-\mathrm  {RL}_i)$ (detectability of a difference, not practical equivalence; see text). IEEE~30/57: fail-safe $K{=}2$; IEEE~118: $K{=}3$.}}{12}{table.caption.20}\protected@file@percent }
\newlabel{tab:ieee_power_cases}{{XI}{12}{Paired IEEE transmission-network dispatch (\textbf {25 runs} per case): MACPO vs.\ RL-MACPO. $f_{\mathrm {pure}}$: mean $\pm $ sample std of per-run best-so-far pure cost; lower is better. \textbf {Success}: RL $f_{\mathrm {pure}} \le 2\times $ paired MACPO (catastrophe flag, not a minor-variation tolerance; see text). $\Delta =(\mathrm {MACPO}-\mathrm {RL})/|\mathrm {MACPO}|\times 100\%$ (positive: RL better). \textbf {Median paired $\Delta $} $=\mathrm {median}_i[(\mathrm {MACPO}_i-\mathrm {RL}_i)/|\mathrm {MACPO}_i|]\times 100\%$ (primary cost statistic). \textbf {Wilcoxon}: two-sided signed-rank test on paired $(\mathrm {MACPO}_i-\mathrm {RL}_i)$ (detectability of a difference, not practical equivalence; see text). IEEE~30/57: fail-safe $K{=}2$; IEEE~118: $K{=}3$}{table.caption.20}{}}
