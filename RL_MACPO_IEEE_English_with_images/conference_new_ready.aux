\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Validation of the intermittent gated-consensus rates (Proposition~\ref {prop:intermittent} and Corollary~\ref {cor:intermittent_ms}) on synthetic graphs. Panels (a)~ring and (b)~Erd\H {o}s--R\'enyi. Measured first-moment ($\|\mathbb  {E}\mathbf  {e}\|$, circles) and mean-square ($\mathbb  {E}\|\mathbf  {e}\|^2$, squares) per-loop decay under \emph  {state-independent} Bernoulli gating match $\rho (p\lambda _c)$ and $\rho _{\mathrm  {ms}}=(1-p)+p\rho (\lambda _c)^2$ (lines) with Chebyshev gain $\lambda _c^\star $. This validates the linearized rate formulas; the deployed conflict gate is state-dependent and is assessed empirically in Figs.~\ref {fig:gated_universality}--\ref {fig:masoie_recovery}.}}{13}{figure.caption.15}\protected@file@percent }
\newlabel{fig:gated_convergence}{{5}{13}{Validation of the intermittent gated-consensus rates (Proposition~\ref {prop:intermittent} and Corollary~\ref {cor:intermittent_ms}) on synthetic graphs. Panels (a)~ring and (b)~Erd\H {o}s--R\'enyi. Measured first-moment ($\|\mathbb {E}\mathbf {e}\|$, circles) and mean-square ($\mathbb {E}\|\mathbf {e}\|^2$, squares) per-loop decay under \emph {state-independent} Bernoulli gating match $\rho (p\lambda _c)$ and $\rho _{\mathrm {ms}}=(1-p)+p\rho (\lambda _c)^2$ (lines) with Chebyshev gain $\lambda _c^\star $. This validates the linearized rate formulas; the deployed conflict gate is state-dependent and is assessed empirically in Figs.~\ref {fig:gated_universality}--\ref {fig:masoie_recovery}}{figure.caption.15}{}}
