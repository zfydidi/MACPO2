\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Comparison of adaptive penalty controllers on F3/F5 (LLSO, 25 paired runs per function). MACPO uses static penalty with always-on communication (100\%). Gated controllers share the same gating and selection modules. Metrics are best-so-far $F$ and trigger rate (mean$\pm $std). Wilcoxon tests show no significant differences among gated controllers. Bold marks best gated mean per function. Lower is better.}}{10}{table.caption.8}\protected@file@percent }
\newlabel{tab:penalty_controller_f3_f5}{{VI}{10}{Comparison of adaptive penalty controllers on F3/F5 (LLSO, 25 paired runs per function). MACPO uses static penalty with always-on communication (100\%). Gated controllers share the same gating and selection modules. Metrics are best-so-far $F$ and trigger rate (mean$\pm $std). Wilcoxon tests show no significant differences among gated controllers. Bold marks best gated mean per function. Lower is better}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Final global objective $F$ (Eq.~\eqref {eq:global_objective}) on F1--F6: mean, median, standard deviation, and $p$-value over 25 independent runs. \textbf  {LLSO}: Level-Based Learning Swarm Optimizer; \textbf  {CSO}: Competitive Swarm Optimizer. \textbf  {MACPO} and \textbf  {Proposed} report best-so-far $F$ without penalty terms (Eq.~\eqref  {eq:global_objective}). \textbf  {GFPDO$^{\dagger }$} and \textbf  {DPSO$^{\dagger }$} are external baselines under the protocol in~\cite  {ref_macpo} (per-agent cap $3000\times D_i$). No significance tests for external columns. Tests for Proposed vs.\ MACPO only: paired Wilcoxon signed-rank (LLSO), Mann--Whitney U (CSO). * Proposed better; \# worse (significant at the 0.05 level). Shaded cells: better mean in each Proposed vs.\ MACPO pair. W/T/L: wins/ties/losses for Proposed vs.\ MACPO.}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:macpo_style_all}{{VII}{10}{Final global objective $F$ (Eq.~\protect \eqref {eq:global_objective}) on F1--F6: mean, median, standard deviation, and $p$-value over 25 independent runs. \textbf {LLSO}: Level-Based Learning Swarm Optimizer; \textbf {CSO}: Competitive Swarm Optimizer. \textbf {MACPO} and \textbf {Proposed} report best-so-far $F$ without penalty terms (Eq.~\eqref {eq:global_objective}). \textbf {GFPDO$^{\dagger }$} and \textbf {DPSO$^{\dagger }$} are external baselines under the protocol in~\cite {ref_macpo} (per-agent cap $3000\times D_i$). No significance tests for external columns. Tests for Proposed vs.\ MACPO only: paired Wilcoxon signed-rank (LLSO), Mann--Whitney U (CSO). * Proposed better; \# worse (significant at the 0.05 level). Shaded cells: better mean in each Proposed vs.\ MACPO pair. W/T/L: wins/ties/losses for Proposed vs.\ MACPO}{table.caption.9}{}}
