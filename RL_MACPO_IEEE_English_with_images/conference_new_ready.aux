\newlabel{tab:masoie_gated}{{XI}{13}{Conflict-gated MASOIE vs.\ always-on MASOIE (same binary, 20 agents, matched evaluation budget, $n{=}10$ independent runs; default gate $\lambda {=}1.2$, $K{=}10$). $F$: mean$\pm $std terminal fitness (lower is better). Comm.\ drop is relative to always-on mean communication cost. F2/F4 recover under a gentler gate (Fig.~\ref {fig:masoie_recovery})}{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Operating-point recovery for gated MASOIE (same binary as Table~\ref {tab:masoie_gated}; $K\in \{2,3,4,10\}$). Normalized terminal fitness (gated$/$always-on; below the dashed parity line is better) versus average trigger rate. Lowering $K$ raises the trigger rate and recovers consensus-critical F2 (below parity at $K{=}2$) and F4 (monotone toward parity); consensus-tolerant F6 remains far below parity throughout.}}{13}{figure.caption.17}\protected@file@percent }
\newlabel{fig:masoie_recovery}{{6}{13}{Operating-point recovery for gated MASOIE (same binary as Table~\ref {tab:masoie_gated}; $K\in \{2,3,4,10\}$). Normalized terminal fitness (gated$/$always-on; below the dashed parity line is better) versus average trigger rate. Lowering $K$ raises the trigger rate and recovers consensus-critical F2 (below parity at $K{=}2$) and F4 (monotone toward parity); consensus-tolerant F6 remains far below parity throughout}{figure.caption.17}{}}
