\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Final global objective $F$ (Eq.~\eqref {eq:global_objective}) on F1--F6: mean, median, standard deviation, and $p$-value over 25 independent runs. \textbf  {LLSO}: Level-Based Learning Swarm Optimizer; \textbf  {CSO}: Competitive Swarm Optimizer. \textbf  {MACPO} and \textbf  {Proposed} report best-so-far $F$ without penalty terms (Eq.~\eqref  {eq:global_objective}). \textbf  {GFPDO$^{\dagger }$} and \textbf  {DPSO$^{\dagger }$} are external baselines under the protocol in~\cite  {ref_macpo} (per-agent cap $3000\times D_i$). No significance tests for external columns. Tests for Proposed vs.\ MACPO only: paired Wilcoxon signed-rank (LLSO), Mann--Whitney U (CSO). * Proposed better; \# worse (significant at the 0.05 level). Shaded cells: better mean in each Proposed vs.\ MACPO pair. W/T/L: wins/ties/losses for Proposed vs.\ MACPO.}}{11}{table.caption.9}\protected@file@percent }
\newlabel{tab:macpo_style_all}{{VII}{11}{Final global objective $F$ (Eq.~\protect \eqref {eq:global_objective}) on F1--F6: mean, median, standard deviation, and $p$-value over 25 independent runs. \textbf {LLSO}: Level-Based Learning Swarm Optimizer; \textbf {CSO}: Competitive Swarm Optimizer. \textbf {MACPO} and \textbf {Proposed} report best-so-far $F$ without penalty terms (Eq.~\eqref {eq:global_objective}). \textbf {GFPDO$^{\dagger }$} and \textbf {DPSO$^{\dagger }$} are external baselines under the protocol in~\cite {ref_macpo} (per-agent cap $3000\times D_i$). No significance tests for external columns. Tests for Proposed vs.\ MACPO only: paired Wilcoxon signed-rank (LLSO), Mann--Whitney U (CSO). * Proposed better; \# worse (significant at the 0.05 level). Shaded cells: better mean in each Proposed vs.\ MACPO pair. W/T/L: wins/ties/losses for Proposed vs.\ MACPO}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Final global objective $F$ (Eq.~\eqref  {eq:global_objective}) on F7--F18 over 25 independent runs: MACPO vs.\ Proposed under LLSO and CSO. Both sides target the same $F(\mathbf  {X})$ in Eq.~\eqref  {eq:global_objective}. \textbf  {Proposed} reports best-so-far $F$ without penalty terms. \textbf  {MACPO$^{\ddagger }$} reports archived endpoint fitness, which still includes residual overlap penalty when static negotiation fails to restore consistency (notably F9/F15). Lower is better. Shaded cells mark the better mean within each pair.}}{11}{table.caption.10}\protected@file@percent }
\newlabel{tab:macpo_rl_mean_f1_f18}{{VIII}{11}{Final global objective $F$ (Eq.~\eqref {eq:global_objective}) on F7--F18 over 25 independent runs: MACPO vs.\ Proposed under LLSO and CSO. Both sides target the same $F(\mathbf {X})$ in Eq.~\eqref {eq:global_objective}. \textbf {Proposed} reports best-so-far $F$ without penalty terms. \textbf {MACPO$^{\ddagger }$} reports archived endpoint fitness, which still includes residual overlap penalty when static negotiation fails to restore consistency (notably F9/F15). Lower is better. Shaded cells mark the better mean within each pair}{table.caption.10}{}}
\newlabel{tab:macpo_rl_mean_f1_f18_b}{{VIII}{11}{Final global objective $F$ (Eq.~\eqref {eq:global_objective}) on F7--F18 over 25 independent runs: MACPO vs.\ Proposed under LLSO and CSO. Both sides target the same $F(\mathbf {X})$ in Eq.~\eqref {eq:global_objective}. \textbf {Proposed} reports best-so-far $F$ without penalty terms. \textbf {MACPO$^{\ddagger }$} reports archived endpoint fitness, which still includes residual overlap penalty when static negotiation fails to restore consistency (notably F9/F15). Lower is better. Shaded cells mark the better mean within each pair}{table.caption.10}{}}
