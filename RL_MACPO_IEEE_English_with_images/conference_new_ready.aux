\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Protocol-agnostic conflict gating in a synthetic consensus sandbox ($n{=}15$ seeds; shaded band: std over seeds). Panels (a)--(c): Metropolis averaging, randomized gossip, and simplified best-response. The same three-layer gate (Eq.~\eqref  {eq:local_gate}) is used; frontiers are traced by sweeping fail-safe $K$. In the scarce-communication regime the gate matches or undercuts periodic/random schedules at matched budget (gossip: competitive win rates).}}{12}{figure.caption.13}\protected@file@percent }
\newlabel{fig:gated_universality}{{3}{12}{Protocol-agnostic conflict gating in a synthetic consensus sandbox ($n{=}15$ seeds; shaded band: std over seeds). Panels (a)--(c): Metropolis averaging, randomized gossip, and simplified best-response. The same three-layer gate (Eq.~\eqref {eq:local_gate}) is used; frontiers are traced by sweeping fail-safe $K$. In the scarce-communication regime the gate matches or undercuts periodic/random schedules at matched budget (gossip: competitive win rates)}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Validation of the skip bound (Proposition~\ref {prop:skip}) on a synthetic sandbox at system level ($N{=}12$, $|\mathcal  {D}|{=}4$). Panels (a)--(c): Metropolis averaging, randomized gossip, and best-response. Realized forgone penalty $\Delta P$ of one negotiation round versus mean conflict $\overline  {\mathrm  {CI}}$. All points lie under $L\,N|\mathcal  {D}|\,\overline  {\mathrm  {CI}}$ (red); subplot titles report hold rate and the 95th percentile of $\Delta P$/bound.}}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:skip_bound}{{4}{12}{Validation of the skip bound (Proposition~\ref {prop:skip}) on a synthetic sandbox at system level ($N{=}12$, $|\mathcal {D}|{=}4$). Panels (a)--(c): Metropolis averaging, randomized gossip, and best-response. Realized forgone penalty $\Delta P$ of one negotiation round versus mean conflict $\overline {\mathrm {CI}}$. All points lie under $L\,N|\mathcal {D}|\,\overline {\mathrm {CI}}$ (red); subplot titles report hold rate and the 95th percentile of $\Delta P$/bound}{figure.caption.14}{}}
